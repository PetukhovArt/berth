{
  "permissions": {
    "deny": [
      "Edit(.jig/config.jsonc)",
      "Edit(eslint.config.*)",
      "Edit(tsconfig*.json)",
      "Edit(.oxlintrc.json)",
      "Edit(stratum.config.jsonc)",
      "Edit(stratum.baseline.json)",
      "Edit(knip.json)",
      "Edit(scripts/checks.mjs)",
      "Edit(.gitlab-ci.yml)",
      "Edit(.husky/**)"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/gotchas.mjs\""
          }
        ]
      }
    ]
  }
}
